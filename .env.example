APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tokos_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Envoi des SMS et WhatsApp (ordre des canaux : le suivant prend le relais) ──
MESSAGING_CHANNELS=sms
WHATSAPP_DRIVER=log          # meta, twilio, http, log
SMS_DRIVER=emess,infobip
VERIFICATION_CODE_TTL=10
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CODE_TEMPLATE=code_verification
WHATSAPP_TEXT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr
# Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_FROM=
# Fournisseur HTTP quelconque
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_HTTP_TO_FIELD=to
SMS_HTTP_TEXT_FIELD=message
SMS_HTTP_EXTRA={"sender":"SOSA"}

# ── Médias : public (le serveur) ou r2 (Cloudflare R2) ──
MEDIA_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── Certification ──
CERTIFICATION_KEEP_DAYS=30

# ── Compression des médias (ffmpeg pour vidéo et audio) ──
MEDIA_COMPRESS=true
FFMPEG_BINARY=ffmpeg
MEDIA_VIDEO_SIZE=720
MEDIA_VIDEO_CRF=28

# ── Application Android (TWA, via PWABuilder) ──
TWA_PACKAGE=
TWA_SHA256=

# Position → ville (compétitions réservées à une ville). nominatim = OpenStreetMap, local = table de villes seulement
GEOCODER=nominatim
LOCATION_ACTION_MINUTES=15

# SasPay (achat de coins par mobile money) : se règle aussi dans l'admin, Réglages → Paiements
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

# SMS : eMess (https://emess.cd) d'abord, Infobip en relais. Modèle approuvé sur le compte :
#   auth-otp : [{app_name}] Votre code de vérification est {code}. Il expire dans {validity_minutes} min. Ne le partagez pas.
EMESS_APP_ID=
EMESS_SECRET_KEY=
EMESS_CODE_TEMPLATE=auth-otp
EMESS_CODE_TEXT=
SMS_APP_NAME=Sosa
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=Sosa

# Push de l'app (Firebase Cloud Messaging) : compte de service téléchargé depuis Firebase (Paramètres du projet → Comptes de service)
FCM_PROJECT_ID=
FCM_CREDENTIALS=storage/app/firebase.json
# --- Déploiement / tâches automatiques ---
# Code secret de l'adresse /api/cron/... (vide = code généré, visible dans l'admin « Tâches automatiques »)
CRON_TOKEN=
# Adresse propre aux Espaces (lions.sosa.social). Vide = domaine de APP_URL ; désactivé sur localhost
SPACE_DOMAIN=
# Modele SMS du defi envoye par numero (variables : app_name, name, title, lien). Vide = SMS libre (refuse par eMess)
EMESS_INVITATION_TEMPLATE=
EMESS_INVITATION_TEXT=
